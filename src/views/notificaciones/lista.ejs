<%- include('../partials/head') %>
<div class="pagina-titulo">
  <h1>Notificaciones <% if (noLeidas > 0) { %><span class="insignia ins-ASIGNADA"><%= noLeidas %> nuevas</span><% } %></h1>
  <% if (items.length) { %>
    <form method="POST" action="/notificaciones/leer-todas"><button class="boton secundario" type="submit">Marcar todas como leidas</button></form>
  <% } %>
</div>

<div class="panel">
  <% if (!items.length) { %>
    <p class="texto-suave sin-margen">No tiene notificaciones.</p>
  <% } %>
  <% items.forEach(function(n) { %>
    <div class="notificacion <%= n.leida ? '' : 'no-leida' %>">
      <div>
        <div><%= n.mensaje %></div>
        <div class="texto-suave">
          <% if (n.solicitud_codigo) { %><a href="/solicitudes/<%= n.solicitud_codigo %>"><%= n.solicitud_codigo %></a> · <% } %>
          Tipo: <%= n.tipo %>
        </div>
      </div>
      <div class="fecha">
        <%= n.fecha %>
        <% if (!n.leida) { %>
          <form method="POST" action="/notificaciones/leer" class="inline">
            <input type="hidden" name="id" value="<%= n.id %>">
            <button class="boton chico secundario" type="submit">Leida</button>
          </form>
        <% } %>
      </div>
    </div>
  <% }) %>
</div>
<%- include('../partials/footer') %>
